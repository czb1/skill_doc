")\n            w3_data = await page.evaluate(js_code)\n            \n            for key, value in w3_data.items():\n                if key in result_data:\n                    result_data[key] = value\n                    print(f\"  {key}: {len(value)} 条\")\n            \n            return result_data\n            \n        except Exception as e:\n            print(f\"抓取错误: {e}\")\n            raise\n        finally:\n            if browser:\n                await browser.close()\n\n\ndef update_w3_today_json(w3_json_path: str, w3_data: dict) -> bool:\n    \"\"\"更新 w3_today.json 中的 items 数据\"\"\"\n    try:\n        with open(w3_json_path, 'r', encoding='utf-8') as f:\n            data = json.load(f)\n        \n        # 建立标题到 index 的映射\n        title_to_idx = {}\n        for idx, section in enumerate(data['sections']):\n            title = section['title'].replace(' Top5', '')\n            title_to_idx[title] = idx\n        \n        # 更新每个 section 的 items\n        updated_count = 0\n        for title, items in w3_data.items():\n            if title in title_to_idx:\n                idx = title_to_idx[title]\n                section = data['sections'][idx]\n                \n                # 清空现有 items 并填入新数据\n                section['items'] = []\n                \n                for item in items:\n                    # 确定 meta_html 格式\n                    if item.get('date'):\n                        meta_html = f'<span class=\"badge\">{item[\"date\"]}</span>'\n                    elif item.get('author'):\n                        meta_html = f'<span class=\"badge\">[{item[\"author\"]}]</span> 3MS 博客'\n                    else:\n                        # B 类：外部社区，无日期无作者\n                        meta_html = f'<span class=\"badge\">{title}</span>'\n                    \n                    section['items'].append({\n                        'rank': item.get('rank', 0),\n                        'title': item.get('title', ''),\n                        'url': item.get('url', ''),\n                        'meta_html': meta_html\n                    })\n                \n                updated_count += 1\n        \n        # 更新 data_source\n        data['data_source'] = 'playwright-ok'\n        \n        # 保存更新后的 JSON\n        with open(w3_json_path, 'w', encoding='utf-8') as f:\n            json.dump(data, f, ensure_ascii=False, indent=2)\n        \n        print(f\"✅ 成功更新 {updated_count} 个板块的 items\")\n        return True\n        \n    except Exception as e:\n        print(f\"更新 JSON 失败: {e}\")\n        return False\n\n\nasync def main():\n    if len(sys.argv) < 2:\n        print(\"用法: python fetch_w3_with_playwright.py <w3_today.json路径>\")\n        sys.exit(1)\n    \n    w3_json_path = sys.argv[1]\n    \n    if not Path(w3_json_path).exists():\n        print(f\"错误: 文件不存在 {w3_json_path}\")\n        sys.exit(1)\n    \n    print(\"=\" * 60)\n    print(\"W3 日报抓取器 (使用系统 Edge/Chrome 浏览器)\")\n    print(\"=\" * 60)\n    \n    # 抓取 W3 数据\n    w3_data = await fetch_w3_data(w3_json_path)\n    \n    # 更新 JSON 文件\n    success = update_w3_today_json(w3_json_path, w3_data)\n    \n    if success:\n        print(\"\\n✅ W3 数据抓取并更新完成!\")\n    else:\n        print(\"\\n❌ W3 数据更新失败\")\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    asyncio.run(main())","filePath":"D:\\Documents\\08Repositories\\AgentInsight\\skills\\w3-daily-report\\scripts\\fetch_w3_with_playwright.py"}
